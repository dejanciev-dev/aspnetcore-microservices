{
  "realm": "storefront",
  "displayName": "Storefront",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 3600,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Can manage the product catalog" },
      { "name": "customer", "description": "Can shop and place orders" }
    ]
  },
  "defaultRole": {
    "name": "default-roles-storefront",
    "composite": true,
    "composites": { "realm": ["customer", "offline_access", "uma_authorization"] }
  },
  "clients": [
    {
      "clientId": "storefront-bff",
      "name": "Storefront (BFF / API gateway)",
      "description": "Confidential client used by the YARP gateway. The secret is for local development only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "storefront-bff-dev-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:4200/signin-oidc",
        "http://localhost:5100/signin-oidc"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##http://localhost:5100/*"
      },
      "protocolMappers": [
        {
          "name": "storefront-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "storefront-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "storefront-tests",
      "name": "Integration tests",
      "description": "Public client with the password grant, used only by the automated tests to obtain real tokens. Remove it outside development.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "storefront-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "storefront-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "ada",
      "enabled": true,
      "email": "ada@example.com",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Lovelace",
      "credentials": [{ "type": "password", "value": "ada", "temporary": false }],
      "realmRoles": ["default-roles-storefront", "admin"]
    },
    {
      "username": "grace",
      "enabled": true,
      "email": "grace@example.com",
      "emailVerified": true,
      "firstName": "Grace",
      "lastName": "Hopper",
      "credentials": [{ "type": "password", "value": "grace", "temporary": false }],
      "realmRoles": ["default-roles-storefront"]
    }
  ]
}
