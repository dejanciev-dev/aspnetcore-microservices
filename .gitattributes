* text=auto

# Files consumed inside Linux containers / CI must keep LF line endings.
Dockerfile   text eol=lf
*.sh         text eol=lf
*.conf       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf

# Pact files are rewritten by the contract tests (always LF); CI diffs them against the commit.
tests/Services.ContractTests/pacts/*.json  text eol=lf
