{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "Authority": "http://localhost:8080/realms/storefront",
    "ClientId": "storefront-bff"
  },
  "RateLimiting": {
    "Anonymous": {
      "TokenLimit": 60,
      "TokensPerPeriod": 30,
      "ReplenishmentPeriodSeconds": 10
    },
    "Authenticated": {
      "TokenLimit": 200,
      "TokensPerPeriod": 100,
      "ReplenishmentPeriodSeconds": 10
    },
    "Checkout": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "OutputCaching": {
    "CatalogSeconds": 60
  },
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog",
        "OutputCachePolicy": "catalog",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "basket": {
        "ClusterId": "basket",
        "Match": {
          "Path": "/api/basket/{**catch-all}"
        }
      },
      "basket-checkout": {
        "ClusterId": "basket",
        "RateLimiterPolicy": "checkout",
        "Match": {
          "Path": "/api/basket/checkout",
          "Methods": [
            "POST"
          ]
        }
      },
      "ordering": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "basket": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "ordering": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5103"
          }
        }
      }
    }
  }
}
