{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "basket": {
        "ClusterId": "basket",
        "Match": { "Path": "/api/basket/{**catch-all}" }
      },
      "ordering": {
        "ClusterId": "ordering",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": { "d1": { "Address": "http://localhost:5101" } }
      },
      "basket": {
        "Destinations": { "d1": { "Address": "http://localhost:5102" } }
      },
      "ordering": {
        "Destinations": { "d1": { "Address": "http://localhost:5103" } }
      }
    }
  }
}
